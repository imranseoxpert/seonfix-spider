{
  "name": "seonfix-spider",
  "version": "2.0.0",
  "productName": "Seonfix Spider",
  "description": "Seonfix Spider - a local website crawler for technical SEO audits on macOS and Windows",
  "license": "MIT",
  "author": "Seonfix",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/crawler.test.js test/extract.test.js test/issues.test.js test/robots.test.js test/sitemap.test.js test/urlutil.test.js test/v2.test.js",
    "wordlist": "node scripts/make-wordlist.js",
    "test:app": "node scripts/run-smoke.js",
    "live": "node scripts/live-crawl.js",
    "icons": "python3 scripts/make-icons.py",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "keywords": [
    "seo",
    "crawler",
    "site audit",
    "electron"
  ],
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.seonfix.spider",
    "productName": "Seonfix Spider",
    "artifactName": "Seonfix-Spider-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright (c) 2026 Seonfix",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "test/smoke-electron.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Seonfix Spider ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
